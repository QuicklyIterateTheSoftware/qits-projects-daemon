<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for qits-projects-daemon, the per-project agent container. Trimmed to
         only what the modules need — the quarkus-bom import, the version-management entries for
         the reactor's own module and the released harness library, and the
         quarkus/compiler/surefire plugin pins. The monorepo's
         app-wide machinery (spotless, enforcer, jandex, test chunking) is deliberately absent: the
         clone-alone rule is that `./mvnw verify` is green from this repo with nothing else on
         disk — which since the harness cutover means Maven Central plus the platform's own Maven
         registry, where eu.wohlben.qits:qits-coding-agents is published. -->
    <groupId>eu.wohlben</groupId>
    <artifactId>qits</artifactId>
    <version>2026.909.114544</version>
    <packaging>pom</packaging>

    <modules>
        <!-- Two modules now: the wire contract and the daemon. `qits-commands` and
             `qits-coding-agents` used to sit here as sources and are gone — they live in
             https://github.com/QuicklyIterateTheSoftware/qits-coding-agents and arrive as released
             jars (see the dependencyManagement block below). -->
        <module>projects-daemon-protocol</module>
        <module>projects-daemon</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>

        <!-- The shared harness library, released from qits-coding-agents. A CalVer coordinate, not
             a range: a daemon runs the library version it was built against, so changing harness
             behaviour is a two-step — release the library, then bump this line and release this
             daemon. That is the cost of the two copies becoming one, and it is deliberate.

             *** MUST BE BUMPED BEFORE THIS DAEMON IS RELEASED. *** The value below is the library
             release that still carries the shape-implied surface fallback. Task 747a0225 removes
             that fallback in the library, and this daemon has stopped reading the `desk` field
             (task 56a914b7) — so released against the line as it stands, a launch body carrying
             neither key would be *guessed* at rather than refused, which is precisely the crutch
             this cutover exists to remove. Bump this to the library release carrying 747a0225, then
             release. The daemon's suite compiles against requiredSurface(), so a stale pin fails
             the build rather than shipping quietly; that is on purpose. -->
        <qits-coding-agents.version>2026.909.111643</qits-coding-agents.version>

        <!-- Where the platform publishes it. Overridden by CI (-Dqits.maven.repository.url) and by
             the image build's QITS_MAVEN_REPOSITORY_URL build-arg; the default is the address a
             developer's machine resolves. -->
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Supplies the managed versions the children leave unversioned: quarkus-arc,
                 quarkus-vertx, vertx-core, junit-jupiter, quarkus-junit5. -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The wire contract. Vendored into qits-projects later; see AGENTS.md. -->
            <dependency>
                <groupId>eu.wohlben</groupId>
                <artifactId>projects-daemon-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- The command and coding-agent capability jars — RELEASED ARTIFACTS NOW, not
                 modules of this reactor. They were built here from sources that were a copy of
                 qits-workspace-daemon's, under `eu.wohlben.qits.projectsdaemon.*` package roots;
                 the union of the two copies moved to its own repository and both daemons depend
                 on it. The groupId gained a `.qits` segment with the move, so a stale local
                 install of the old coordinate cannot be picked up by accident. -->
            <dependency>
                <groupId>eu.wohlben.qits</groupId>
                <artifactId>qits-commands</artifactId>
                <version>${qits-coding-agents.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.wohlben.qits</groupId>
                <artifactId>qits-coding-agents</artifactId>
                <version>${qits-coding-agents.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- The platform's own Maven repository, where the harness library is published. New with the
         cutover: this reactor resolved everything from Central until it stopped carrying the
         harness as sources. The id has to stay `qits-maven` — it is what the settings file's
         exact-id mirror matches (Maven blocks external http:// repositories otherwise) and what a
         locally cached copy is recorded under. -->
    <repositories>
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
